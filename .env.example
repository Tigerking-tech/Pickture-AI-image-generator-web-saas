# Supabase — get these from your Supabase project settings
# Leave as placeholder to enable Demo Mode (no external services needed)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Creem — get from Dashboard > Developers > API & Webhooks
# Test keys start with creem_test_ (auto-detected)
CREEM_API_KEY=creem_test_your-api-key
CREEM_WEBHOOK_SECRET=whsec_your-webhook-secret

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Creem Product IDs — create in Creem Dashboard > Commerce > Products
# Plans: Free $0 (no product ID) / Pro $12 / Scale $29
NEXT_PUBLIC_CREEM_PRO_PRODUCT_ID=prod_pro
NEXT_PUBLIC_CREEM_SCALE_PRODUCT_ID=prod_scale

# Admin — set to your email for admin panel access
ADMIN_EMAIL=admin@example.com

# Email (Resend) — optional, emails skipped without this
RESEND_API_KEY=
RESEND_FROM_EMAIL=Surepix <noreply@yourdomain.com>

# Site URL (for SEO sitemap/robots)
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Rate Limiting (Upstash) — optional, rate limiting disabled without these
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ===== 方案 A：PhotoCraft 引擎微服务（Render 部署）=====
# 仅在 Vercel 前端侧设置；指向 Render 上 engine 服务的地址（见 render.yaml / DEPLOY_PLAN_A.md）
# 不设 PC_API 时，pc.ts 会回退到本地 photocraft-cli（本地开发默认行为）
PC_API=
# 与 Render 引擎服务的 PC_TOKEN 完全相同的密钥（Bearer 鉴权）
PC_API_TOKEN=

# ===== 语义重生成后端（文生图 / 生成模型）=====
# 路由层判出 regenerate / hybrid 时走这里。默认 mock（dev/CI 无 key 也能跑通管线）。
# 生产切真实模型：GENERATIVE_PROVIDER=fal 并填 FAL_KEY（见 src/lib/generative.ts）

# 按语义意图自动映射不同 fal 专用模型（见 src/lib/generative.ts 的 FAL_MODELS）：
#   swap_background / change_material / change_object_color / add_object -> fal-ai/flux-pro/kontext
#   remove_object / change_text                                      -> fal-ai/flux-pro/kontext/max
#   style_transfer                                                   -> fal-ai/flux/dev/image-to-image (img2img)
#   extend_image                                                     -> fal-ai/flux-2-pro/outpaint
#   upscale                                                          -> fal-ai/real-esrgan
# 请求体按模型形态自动组装（edit / img2img / outpaint / upscale / inpaint）。
# 想不碰代码就换模型：用 FAL_MODELS_JSON 整体覆盖上面的映射，例如：
# FAL_MODELS_JSON={"remove_object":{"model":"fal-ai/flux-pro/kontext","shape":"edit"},"upscale":{"model":"fal-ai/clarity-upscaler","shape":"upscale"}}
GENERATIVE_PROVIDER=mock
FAL_KEY=
# 可选：未知意图的兜底模型（默认 fal-ai/flux/dev/image-to-image）；已知意图一律走 FAL_MODELS 映射
GENERATIVE_MODEL=
# 可选：fal API 基址（默认 https://fal.run）。自测或私有网关时可改为本地/内网地址
FAL_BASE_URL=https://fal.run
# 可选：单次生成成本（仅用于计费/成本估算展示；FAL_MODELS 里 upscale 自带 0.005）
GENERATIVE_COST_USD=0.02

