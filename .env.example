# Supabase — get these from your Supabase project settings
# Leave as placeholder to enable Demo Mode (no external services needed)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Provider 抽象层（按成本随时切换，无需改代码，仅改 env + Redeploy）──
# IMAGE_PROVIDER: fal (default) | volcano(火山引擎) | tencent(腾讯混元生图)
# TEXT_PROVIDER:  openai (default) | openrouter | tencent(腾讯混元大模型)
IMAGE_PROVIDER=fal
TEXT_PROVIDER=openai

# fal.ai — image generation (get from fal.ai dashboard)
FAL_KEY=your-fal-key

# 火山引擎（Volcengine Ark）图像生成：IMAGE_PROVIDER=volcano 时启用
VOLCANO_API_KEY=your-volcano-key
# 火山模型名与 fal 不同，需显式覆盖传入的模型标识（如 doubao-seedream-3-0-t2i-250415）
VOLCANO_IMAGE_MODEL=

# OpenAI — used for prompt decomposition
OPENAI_API_KEY=your-openai-key

# OpenRouter — TEXT_PROVIDER=openrouter 时启用（OpenAI 兼容，模型池更广）
OPENROUTER_API_KEY=your-openrouter-key

# 腾讯混元（免费档即可跑通）— IMAGE_PROVIDER=tencent / TEXT_PROVIDER=tencent 时启用
# 2026-10 起混元并入 TokenHub：文本与图像共用同一把 TokenHub API Key，一个变量搞定
TENCENT_HUNYUAN_KEY=your-tokenhub-key
# 可选：覆盖文本默认模型（默认 hy3，含 100 万 tokens 免费包）；图像默认 hy-image-v3.0
TENCENT_HUNYUAN_MODEL=
TENCENT_HUNYUAN_IMAGE_MODEL=
# 可选：覆盖 modelRouter 默认的模型名（切换供应商避免改代码）
TEXT_MODEL_FREE=
TEXT_MODEL_PAID=
IMAGE_MODEL_PREVIEW=
IMAGE_MODEL_FINAL=

# Creem — get from Dashboard > Developers > API & Webhooks
# Test keys start with creem_test_ (auto-detected)
CREEM_API_KEY=creem_test_your-api-key
CREEM_WEBHOOK_SECRET=whsec_your-webhook-secret

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Creem Product IDs — create in Creem Dashboard > Commerce > Products
NEXT_PUBLIC_CREEM_STARTER_PRODUCT_ID=prod_starter
NEXT_PUBLIC_CREEM_PRO_PRODUCT_ID=prod_pro
NEXT_PUBLIC_CREEM_ENTERPRISE_PRODUCT_ID=prod_enterprise

# Admin — set to your email for admin panel access
ADMIN_EMAIL=admin@example.com

# Email (Resend) — optional, emails skipped without this
RESEND_API_KEY=
RESEND_FROM_EMAIL=SaaSKit <noreply@yourdomain.com>

# Site URL (for SEO sitemap/robots)
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Rate Limiting (Upstash) — optional, rate limiting disabled without these
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
