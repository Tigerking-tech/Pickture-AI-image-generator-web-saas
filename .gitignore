# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# dev utilities
/screenshots/
/screenshot.mjs

# omc state
.omc/

# beast-plan
.beast-plan/

# Video proof scripts
video-proofs/*.mjs

# Old SaaSKit video proofs (24MB webm, pre-v2 design)
/video-proofs/

# PhotoCraft binary (67MB, MIT — download separately)
/vendor/

# Old SaaSKit template assets (screenshots show pre-v2 design)
# 注：本项目 QC 检查清单 docs/QC-CHECKLIST.md 需入库，故不再整体忽略 /docs/

# damage-test.js outputs (regenerated on each run)
/damage_*.png

# temp build artifacts
/.tmp-fidelity-cjs/

# 分割模型权重（44MB，不入库；用 `npm run model` 拉取）
/assets/models/*.onnx

# 本地推送辅助脚本（含硬编码 PAT 回退值，禁止入库）
push_engine.py
sync_push.py
