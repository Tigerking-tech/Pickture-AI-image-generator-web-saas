# 引擎微服务环境变量（部署到 Render 时填写）
# 1) 访问令牌：请生成一段随机密钥（如 `openssl rand -hex 32`）
#    必须与 Vercel 前端的 PC_API_TOKEN 完全一致，否则前端调用会被 401 拒绝。
PC_TOKEN=replace-with-a-random-secret

# 2) 锁定的 PhotoCraft 版本（与根仓库 scripts/fetch-photocraft.mjs 的 PC_VERSION 保持一致）
PC_VERSION=0.15.1

# 3) 单次处理超时（毫秒），默认 120000（2 分钟）。超大图可酌情调大。
PC_TIMEOUT_MS=120000

# 4) NODE_ENV
NODE_ENV=production

# 5) PORT 由 Render 自动注入；本地调试可用：PORT=3939 npm start
